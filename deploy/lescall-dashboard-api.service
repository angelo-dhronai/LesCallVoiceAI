[Unit]
Description=lescall dashboard API (FastAPI)
After=network.target

[Service]
Type=simple
User=angelo
WorkingDirectory=/home/angelo/lescall
Environment=PYTHONPATH=/home/angelo/lescall
EnvironmentFile=/home/angelo/lescall/calling-agent/.env
ExecStart=/home/angelo/lescall/calling-agent/venv/bin/python -m uvicorn dashboard.api.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
