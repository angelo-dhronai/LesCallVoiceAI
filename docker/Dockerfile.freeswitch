# lescall FreeSWITCH image — FreeSWITCH (SignalWire repo) + mod_audio_stream built
# from source against THIS image's FS headers (the repo rolled past the host's
# 1.11.0, so the host .so can't be reused — it must be recompiled).
#
# Run host-networked (docker-compose `freeswitch` service, profile fs-container)
# so RTP/SIP behave exactly like the native install — lowest latency, no NAT.

# ---------- build stage: compile mod_audio_stream ----------
FROM debian:bookworm-slim AS build
ENV DEBIAN_FRONTEND=noninteractive
COPY docker/signalwire-freeswitch-repo.gpg /usr/share/keyrings/signalwire-freeswitch-repo.gpg
RUN echo "deb [signed-by=/usr/share/keyrings/signalwire-freeswitch-repo.gpg] \
https://freeswitch.signalwire.com/repo/deb/debian-release/ bookworm main" \
      > /etc/apt/sources.list.d/freeswitch.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        git cmake build-essential pkg-config ca-certificates \
        libfreeswitch-dev libwebsockets-dev libssl-dev libspeexdsp-dev libspeex-dev \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/amigniter/mod_audio_stream.git /src/mod_audio_stream \
 && cmake -S /src/mod_audio_stream -B /src/mod_audio_stream/build \
 && cmake --build /src/mod_audio_stream/build --config Release \
 && cp /src/mod_audio_stream/build/mod_audio_stream.so /tmp/mod_audio_stream.so

# ---------- runtime stage ----------
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
COPY docker/signalwire-freeswitch-repo.gpg /usr/share/keyrings/signalwire-freeswitch-repo.gpg
RUN echo "deb [signed-by=/usr/share/keyrings/signalwire-freeswitch-repo.gpg] \
https://freeswitch.signalwire.com/repo/deb/debian-release/ bookworm main" \
      > /etc/apt/sources.list.d/freeswitch.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        freeswitch freeswitch-meta-all libwebsockets18 libspeexdsp1 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Our checked-in configuration + the freshly built module.
COPY freeswitch/etc/ /etc/freeswitch/
COPY --from=build /tmp/mod_audio_stream.so /usr/lib/freeswitch/mod/mod_audio_stream.so

EXPOSE 5060/udp 5080/udp 8021/tcp 16384-32768/udp
CMD ["freeswitch", "-u", "freeswitch", "-g", "freeswitch", "-nonat", "-nc", "-nf"]
