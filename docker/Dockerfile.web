# lescall dashboard web — build the React SPA, serve via nginx with TLS.
FROM node:20-alpine AS build
WORKDIR /web
COPY dashboard/web/package.json dashboard/web/package-lock.json* ./
RUN npm install
COPY dashboard/web/ ./
RUN npm run build

FROM nginx:alpine
# TLS-terminating config (Let's Encrypt certs mounted at runtime via compose).
COPY docker/nginx.web-tls.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80 443
